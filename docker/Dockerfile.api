# docker/Dockerfile.api
# Servicio API RESTful - FastAPI con endpoints de ML
# SCY1101 EFT | Accidentes de Trafico Espana 2024

FROM python:3.11-slim

LABEL maintainer="SCY1101-EFT"
LABEL description="API RESTful FastAPI con datos y modelos de Machine Learning"

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api/ ./api/
COPY etl/ ./etl/
COPY models/ ./models/

RUN mkdir -p /data

ENV SQLITE_PATH=/data/accidentes_ep3.db
ENV CSV_PATH=/data/accidentes_limpios.csv
ENV MODELS_DIR=/app/models
ENV API_PORT=8000

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
